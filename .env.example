# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/evalio
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5433/evalio

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM Provider ===
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# === Scraper ===
PROXY_URL=
RAW_HTML_BUCKET=

# === App ===
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000

# === Freshness TTLs ===
PRICE_STALE_AFTER_HOURS=24
REVIEW_STALE_AFTER_DAYS=7
COMPONENT_SCORE_STALE_AFTER_DAYS=30

# === Retrieval ===
MAX_SQL_CANDIDATES=300
MAX_VECTOR_CANDIDATES=50
MAX_RANK_CANDIDATES=30

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

GEMINI_API_KEY=
